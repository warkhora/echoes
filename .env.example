# ---------------------------------------------------------------------------
# Echoes — environment template
# Copy to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Database (provided by the platform in this sandbox)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Spotify — create an app at https://developer.spotify.com/dashboard
# Whitelist this exact redirect URI in the app settings:
#   http://localhost:3000/   (plus your deployed origin, e.g. https://echoes.app/)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional — defaults to `${window.location.origin}${window.location.pathname}`
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/

# Notes
# -----
# * The PKCE flow never needs a client secret; nothing sensitive is bundled.
# * Leave NEXT_PUBLIC_SPOTIFY_CLIENT_ID empty to run Echoes in Demo Mode —
#   the full interface is served from the local Postgres catalog instead.

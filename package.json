{
  "name": "echoes-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.echoes.desktop",
    "productName": "Echoes",
    "directories": { "output": "dist" },
    "files": ["electron/**/*"],
    "extraResources": [{ "from": "out", "to": "out" }],
    "win": { "target": "nsis", "artifactName": "Echoes-Setup-${version}.${ext}" },
    "mac": { "target": "dmg", "artifactName": "Echoes-${version}-${arch}.${ext}" }
  }
}
